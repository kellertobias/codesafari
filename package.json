{
  "name": "@codetour/local",
  "version": "0.1.0",
  "description": "Turn a .tour/ folder plus inline @tour source comments into a local, offline code-tour website.",
  "keywords": [
    "code-tour",
    "documentation",
    "onboarding",
    "walkthrough",
    "monokai",
    "offline"
  ],
  "license": "MIT",
  "type": "module",
  "bin": {
    "codetour": "dist/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "viewer-dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "npm run build:core && npm run build:viewer",
    "build:core": "tsc -p tsconfig.build.json",
    "build:viewer": "vite build viewer",
    "dev:core": "tsc -p tsconfig.build.json --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "chokidar": "^3.6.0",
    "gray-matter": "^4.0.3",
    "ignore": "^5.3.1",
    "mermaid": "^11.0.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/ws": "^8.5.10",
    "@vitejs/plugin-react": "^4.7.0",
    "highlight.js": "^11.11.1",
    "marked": "^18.0.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.5.0",
    "vite": "^5.4.0",
    "vitest": "^2.0.0"
  }
}
